[Unit]
Description=iot_mgm_client
After=network.target
StartLimitIntervalSec=3

[Service]
Type=simple
User=acr_iot             
WorkingDirectory=/opt/iot_mgm_client
Environment=PATH=/opt/iot_mgm_client/scripts:$PATH
ExecStart=/usr/bin/python3 ./src/client.py   
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

